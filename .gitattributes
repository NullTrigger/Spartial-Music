# Normalize to LF in the repository, regardless of the checkout OS.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.jar binary
*.png binary
*.webp binary
*.jpg binary
*.keystore binary
*.jks binary

# Markup only lives here as design previews and screenshots, never as code the
# repository is written in. Without this a saved web page reads as 43% of the
# project's languages; linguist skips documentation files.
*.html linguist-documentation
