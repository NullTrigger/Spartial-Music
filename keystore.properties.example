#
# REAL FILE – never commit a filled-in copy of this.
#
# 1. Copy to `keystore.properties` (git-ignored).
# 2. Replace the fake values below with the ones you chose when creating the
#    keystore (see BUILDING.md). Use forward slashes or escaped backslashes.
# 3. If this file is missing, `assembleRelease` falls back to debug signing so
#    contributors can still build; `assembleDebug` never needs it.

# Path to the keystore, relative to the repository root (or absolute).
storeFile=nodes-release.jks

# Password for the keystore itself.
storePassword=change-me

# Alias of the signing key inside the keystore.
keyAlias=nodes

# Password for that key (often the same as storePassword).
keyPassword=change-me
