<!--
  Google Play services build only. Cast needs the Cast options provider the
  framework reads to build its CastContext (DefaultCastOptionsProvider
  renders a Chromecast-ready config). Session transfer itself is offered by
  the Output Switcher behind the MediaRouteButton; Media3 has no static
  receiver to register for that on current versions. Wi-Fi state permissions
  are the standard Cast discovery pair.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application>
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="androidx.media3.cast.DefaultCastOptionsProvider" />
    </application>
</manifest>
