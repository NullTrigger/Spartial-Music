<full-backup-content>
    <!-- The library database and settings are backed up; cached remote
         responses and external files are never included. The encrypted
         YouTube Music session cookie (innertube_session) is excluded: a
         backup must never carry an account session to another device. -->
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="innertube_session.xml" />
</full-backup-content>
