<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <!-- The encrypted YouTube Music session cookie is not included in
             cloud backup, even when other app data is backed up. -->
        <exclude domain="sharedpref" path="innertube_session.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="innertube_session.xml" />
    </device-transfer>
</data-extraction-rules>
