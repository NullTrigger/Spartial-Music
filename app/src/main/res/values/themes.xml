<resources>
    <style name="Theme.Nodes" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nodes_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.Nodes.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nodes_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_nodes_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Nodes</item>
    </style>
</resources>
